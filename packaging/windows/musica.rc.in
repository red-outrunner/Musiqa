#include <windows.h>

IDI_MUSICA_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/musica.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "weo sikho fuzile\0"
            VALUE "FileDescription", "Musica music player\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "musicplayer\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 weo sikho fuzile and contributors; GPL-3.0-or-later\0"
            VALUE "OriginalFilename", "musicplayer.exe\0"
            VALUE "ProductName", "Musica\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
